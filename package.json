{
  "name": "chromalab",
  "version": "0.1.0",
  "private": true,
  "description": "A browser-based colorimetric and print-production workbench built on a reusable JavaScript color science engine.",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --port 3000 --strictPort",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch \"tests/**/*.test.js\"",
    "serve": "node scripts/serve.js",
    "deploy": "vercel deploy --prod --yes --name colorengine",
    "deploy:preview": "vercel deploy --yes --name colorengine"
  },
  "dependencies": {
    "lcms-wasm": "1.0.5"
  },
  "devDependencies": {
    "vite": "^7.1.5"
  }
}
